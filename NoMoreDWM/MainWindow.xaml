<Window x:Class="NoMoreDWM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoMoreDWM" Height="576" Width="1006">
    <Window.Resources>
        <!-- Define Light and Dark Themes -->
        <ResourceDictionary>
            <!-- Light Theme -->
            <ResourceDictionary x:Key="LightTheme">
                <SolidColorBrush x:Key="WindowBackground" Color="White"/>
                <SolidColorBrush x:Key="TextForeground" Color="Black"/>
                <SolidColorBrush x:Key="ButtonBackground" Color="Black"/>
                <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
            </ResourceDictionary>

            <!-- Dark Theme -->
            <ResourceDictionary x:Key="DarkTheme">
                <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
                <SolidColorBrush x:Key="TextForeground" Color="White"/>
                <SolidColorBrush x:Key="ButtonBackground" Color="#3C3C3C"/>
                <SolidColorBrush x:Key="ButtonForeground" Color="White"/>
            </ResourceDictionary>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <TextBlock Text="NoMoreDWM – A simple program to disable Desktop Window Manager"
                   FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,20,0,0"
                   Foreground="{DynamicResource TextForeground}" />

        <Button x:Name="btnDisableDWM"
                Content="Disable DWM"
                FontSize="20"
                FontWeight="Bold"
                Width="300"
                Height="50"
                Background="{DynamicResource ButtonBackground}"
                Foreground="{DynamicResource ButtonForeground}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="203,0,0,0"
                Click="DisableDWM_Click"/>

        <Button x:Name="btnEnableDWM"
                Content="Enable DWM"
                FontSize="20"
                FontWeight="Bold"
                Width="300"
                Height="50"
                Background="{DynamicResource ButtonBackground}"
                Foreground="{DynamicResource ButtonForeground}"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="527,0,0,0"
                Click="EnableDWM_Click"/>

        <TextBlock
                   FontSize="12"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Margin="10,0,0,10"
                   Foreground="{DynamicResource TextForeground}">
            <Run Language="en-US" Text="Version 2.0.1"/>
        </TextBlock>

        <TextBlock Text="Programmed by TK50P"
                   FontSize="12"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,10,10"
                   Foreground="{DynamicResource TextForeground}" />

        <!-- Status TextBlock -->
        <TextBlock FontSize="36"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="304,358,0,0"
                   Foreground="{DynamicResource TextForeground}">
            <Run Language="en-US" Text="DWM is currently: "/>
            <Run Language="en-US" Text="{Binding DwmStatus}"/>
        </TextBlock>

        <!-- Theme Toggle Button -->
        <Button x:Name="btnToggleTheme"
                Content="Toggle Theme"
                FontSize="14"
                Width="120"
                Height="36"
                Background="{DynamicResource ButtonBackground}"
                Foreground="{DynamicResource ButtonForeground}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Click="ToggleTheme_Click"/>
    </Grid>
</Window>
